+/// 缺失中间帧或尾帧必须在创建收集目录前失败，不能默默截断。
+#[test]
+fn collect_image_sequence_rejects_missing_or_truncated_frames() {
+    for missing in [6usize, 11] {
+        let dir = tmp_dir("imgseq-collect-missing");
+        let paths = write_frames(&dir, "missing_", &(0..12).collect::<Vec<u32>>(), "png");
+        let mut s = demo();
+        s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": {"num": 12, "den": 1}})).unwrap();
+        std::fs::remove_file(&paths[missing]).unwrap();
+        let dest = dir.join("delivery");
+        assert!(s.execute("file.projectManager", json!({"destination": dest.to_string_lossy(), "excludeUnused": false, "wait": true})).is_err());
+        assert!(!dest.exists());
+        let _ = std::fs::remove_dir_all(dir);
+    }
+}
