+/// 收集必须保留整段图片序列；移走原素材后仍解码第六帧。
+#[test]
+fn collect_image_sequence_preserves_all_frames_and_reopens() {
+    let dir = tmp_dir("imgseq-collect-all");
+    let input = dir.join("input");
+    std::fs::create_dir_all(&input).unwrap();
+    let paths = write_frames(&input, "frame_", &(0..12).collect::<Vec<u32>>(), "png");
+    let mut s = demo();
+    let r = s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": {"num": 12, "den": 1}})).unwrap();
+    let id = item_of(&r);
+    let dest = dir.join("delivery");
+    let r = s.execute("file.projectManager", json!({"destination": dest.to_string_lossy(), "excludeUnused": false, "includeProxies": false, "wait": true})).unwrap();
+    let entry = r["files"].as_array().unwrap().iter().find(|x| x["item"] == id.0).unwrap();
+    assert_eq!(entry["sequenceFiles"].as_array().map(Vec::len), Some(12), "collection must include all numbered frames: {entry}");
+    for frame in entry["sequenceFiles"].as_array().unwrap() {
+        assert_eq!(std::fs::read(frame["from"].as_str().unwrap()).unwrap(), std::fs::read(frame["to"].as_str().unwrap()).unwrap());
+    }
+    std::fs::rename(&input, dir.join("input-gone")).unwrap();
+    let mut reopened = Session::default();
+    reopened.execute("file.open", json!({"path": r["project"].as_str().unwrap()})).unwrap();
+    assert_eq!(red_at(&reopened, id, 6), 60);
+    assert_eq!(reopened.project.item(id).unwrap().as_media().unwrap().info.duration, FrameRate::new(12, 1).tick_of(12));
+    let _ = std::fs::remove_dir_all(dir);
+}
