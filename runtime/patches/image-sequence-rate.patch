+/// 同名帧序列隔离在不同素材目录，不得相互覆盖。
+#[test]
+fn collect_same_named_sequences_keep_distinct_frames_and_alpha() {
+    let dir = tmp_dir("imgseq-collect-collision");
+    let mut s = demo();
+    let mut items = Vec::new();
+    for (name, colour) in [("first", [60, 99, 7, 128]), ("second", [90, 99, 7, 64])] {
+        let input = dir.join(name);
+        std::fs::create_dir_all(&input).unwrap();
+        let paths = write_frames(&input, "frame_", &(0..12).collect::<Vec<u32>>(), "png");
+        image::RgbaImage::from_pixel(32, 18, image::Rgba(colour)).save(&paths[6]).unwrap();
+        let r = s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": {"num": 12, "den": 1}})).unwrap();
+        items.push((item_of(&r), colour));
+    }
+    let dest = dir.join("delivery");
+    let r = s.execute("file.projectManager", json!({"destination": dest.to_string_lossy(), "excludeUnused": false, "wait": true})).unwrap();
+    let jobs = s.execute("jobs.list", json!({})).unwrap();
+    assert!(jobs.as_array().unwrap().last().unwrap()["result"].get("error").is_none(), "{jobs}");
+    std::fs::rename(dir.join("first"), dir.join("first-gone")).unwrap();
+    std::fs::rename(dir.join("second"), dir.join("second-gone")).unwrap();
+    let mut reopened = Session::default();
+    reopened.execute("file.open", json!({"path": r["project"].as_str().unwrap()})).unwrap();
+    for (item, colour) in items {
+        let src = reopened.media.source_for(&reopened.project, item, &*reopened.services).unwrap();
+        let frame = src.video_frame(FrameRequest::full(FrameRate::new(12, 1).tick_of(6))).unwrap();
+        match &frame.data {
+            filmcraft_frame::PixelData::Rgba8(p) => assert_eq!(&p[..4], &colour),
+            _ => panic!("expected rgba"),
+        }
+    }
+    let _ = std::fs::remove_dir_all(dir);
+}
