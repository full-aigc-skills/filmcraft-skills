+/// 显式帧率必须控制原生媒体时长，不能使用会话默认 29.97 fps。
+#[test]
+fn explicit_image_sequence_rate_preserves_twelve_frame_second() {
+    let dir = tmp_dir("imgseq-explicit-rate");
+    let mut s = demo();
+    let paths = write_frames(&dir, "explicit_", &(0..12).collect::<Vec<u32>>(), "png");
+    let original = s.prefs.media.indeterminate_timebase.clone();
+    let r = s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": {"num": 12, "den": 1}})).unwrap();
+    let id = item_of(&r);
+    let media = s.project.item(id).unwrap().as_media().unwrap();
+    assert_eq!(media.info.frame_rate(), FrameRate::new(12, 1));
+    assert_eq!(media.info.duration, FrameRate::new(12, 1).tick_of(12));
+    assert_eq!(s.prefs.media.indeterminate_timebase, original);
+    assert_eq!(red_at(&s, id, 6), 60);
+    for rate in [json!({"num": 0, "den": 1}), json!({"num": 12, "den": 0}), json!({"num": 241, "den": 1}), json!({"num": 12, "den": 1, "extra": true})] {
+        assert!(s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": rate})).is_err());
+    }
+    let project = dir.join("explicit.fcproj");
+    s.execute("file.saveAs", json!({"path": project.to_string_lossy()})).unwrap();
+    let mut reopened = Session::default();
+    reopened.execute("file.open", json!({"path": project.to_string_lossy()})).unwrap();
+    let media = reopened.project.item(id).unwrap().as_media().unwrap();
+    assert_eq!(media.info.frame_rate(), FrameRate::new(12, 1));
+    assert_eq!(media.info.duration, FrameRate::new(12, 1).tick_of(12));
+    assert_eq!(red_at(&reopened, id, 6), 60);
+    assert_eq!(reopened.prefs.media.indeterminate_timebase, original);
+    let _ = std::fs::remove_dir_all(dir);
+}
