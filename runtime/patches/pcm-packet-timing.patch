+/// 从包字节长度累计 PCM 采样位置，消除容器时间戳量化导致的包边界缺口。
+/// 只合并一个时间戳单位内的舍入误差；更大的真实间隔仍按容器时间定位。
+fn pcm_starts(track: &filmcraft_matroska::Track, rate: i64, channels: u32, bits: u16) -> crate::Result<Vec<i64>> {
+    if rate <= 0 || channels == 0 || bits == 0 {
+        return Err(CodecError::Decode("invalid PCM timing metadata".into()));
+    }
+    let stride = u64::from(bits).div_ceil(8).checked_mul(u64::from(channels)).ok_or_else(|| CodecError::Decode("PCM frame size overflow".into()))?;
+    let (n, d) = tb(track);
+    let tolerance = ((i128::from(n) * i128::from(rate) + i128::from(d) - 1) / i128::from(d)) + 1;
+    let mut next: Option<i64> = None;
+    let mut starts = Vec::with_capacity(track.samples.len());
+    for (index, sample) in track.samples.iter().enumerate() {
+        let stamped = i128::from(sample.pts)
+            .checked_mul(i128::from(n))
+            .and_then(|value| value.checked_mul(i128::from(rate)))
+            .map(|value| value / i128::from(d))
+            .and_then(|value| i64::try_from(value).ok())
+            .ok_or_else(|| CodecError::Decode("PCM timestamp overflow".into()))?;
+        let size = track.sample_size(index).ok_or_else(|| CodecError::Decode("PCM packet missing".into()))?;
+        if size % stride != 0 {
+            return Err(CodecError::Decode("PCM packet is not frame aligned".into()));
+        }
+        let count = i64::try_from(size / stride).map_err(|_| CodecError::Decode("PCM packet too long".into()))?;
+        let start = match next {
+            Some(value) if (i128::from(value) - i128::from(stamped)).abs() <= tolerance => value,
+            _ => stamped,
+        };
+        starts.push(start);
+        next = Some(start.checked_add(count).ok_or_else(|| CodecError::Decode("PCM sample position overflow".into()))?);
+    }
+    Ok(starts)
 }
 
