+    let moved = dir.join("moved");
+    std::fs::rename(&input, &moved).unwrap();
+    let first = moved.join("frame_0000.png");
+    s.execute("media.relink", json!({"item": item.0, "path": first.to_string_lossy(), "relinkOthers": false})).unwrap();
