+//! 毫秒量化的 Matroska 时间戳不能破坏连续 PCM 样本，真实空隙必须保留。
+use filmcraft_matroska::{MkvWriter, MuxOptions, TrackKind, TrackSpec};
+use filmcraft_media::MediaSource;
+use std::io::Cursor;
+use std::sync::Arc;
+
+fn source(gap_ns: u64) -> (filmcraft_codecs::MkvSource, Vec<f32>) {
+    let mut spec = TrackSpec::new(TrackKind::Audio, "A_PCM/INT/LIT");
+    spec.audio = Some((44_100.0, 2, Some(16)));
+    let mut mux = MkvWriter::new(Cursor::new(Vec::new()), vec![spec], MuxOptions::default()).unwrap();
+    let mut expected = Vec::new();
+    for packet in 0..32u64 {
+        let mut bytes = Vec::new();
+        for sample in 0..1024u64 {
+            let value = (((packet * 1024 + sample) * 7919 % 60000) as i32 - 30000) as i16;
+            bytes.extend_from_slice(&value.to_le_bytes());
+            bytes.extend_from_slice(&value.to_le_bytes());
+            expected.push(value as f32 / 32768.0);
+        }
+        let at = packet * 1024 * 1_000_000_000 / 44_100 + if packet >= 16 { gap_ns } else { 0 };
+        mux.write_frame(0, at as i64, true, &bytes, None).unwrap();
+    }
+    let bytes: Arc<[u8]> = mux.finish().unwrap().into_inner().into();
+    (filmcraft_codecs::MkvSource::open("timing.mkv", bytes).unwrap(), expected)
+}
+
+#[test]
+fn pcm_packets_are_sample_exact_despite_millisecond_timestamps() {
+    let (source, expected) = source(0);
+    let actual = source.audio(0, expected.len(), 44_100).unwrap();
+    assert_eq!(actual.channels[0], expected, "rounded packet timestamps insert gaps or overwrite samples");
+    let chunk = source.audio(1511, 3072, 44_100).unwrap();
+    assert_eq!(chunk.channels[0], expected[1511..4583], "random reads must retain the same sample identity");
+}
+
+#[test]
+fn pcm_packet_real_gap_is_not_collapsed() {
+    let (source, _) = source(100_000_000);
+    let actual = source.audio(16 * 1024 + 100, 1000, 44_100).unwrap();
+    assert!(actual.channels.iter().flatten().all(|value| *value == 0.0));
+}
+
+#[test]
+fn pcm_partial_frame_is_refused_without_decode_panic() {
+    let mut spec = TrackSpec::new(TrackKind::Audio, "A_PCM/INT/LIT");
+    spec.audio = Some((44_100.0, 2, Some(16)));
+    let mut mux = MkvWriter::new(Cursor::new(Vec::new()), vec![spec], MuxOptions::default()).unwrap();
+    mux.write_frame(0, 0, true, &[1, 2, 3], None).unwrap();
+    let bytes: Arc<[u8]> = mux.finish().unwrap().into_inner().into();
+    let result = filmcraft_codecs::MkvSource::open("partial.mkv", bytes);
+    assert!(result.is_err(), "partial interleaved PCM frame must not be silently truncated");
+}
