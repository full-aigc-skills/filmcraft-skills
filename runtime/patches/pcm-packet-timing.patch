+    assert_eq!(media.info.kind, MediaKind::ImageSequence);
+    assert_eq!(media.info.frame_rate(), FrameRate::new(12, 1));
+    assert_eq!(media.info.duration, FrameRate::new(12, 1).tick_of(12));
+    assert_eq!(red_at(&s, item, 6), 60);
+    let incomplete = dir.join("incomplete");
+    std::fs::create_dir_all(&incomplete).unwrap();
+    for n in 0..12 { if n != 6 { std::fs::copy(moved.join(format!("frame_{n:04}.png")), incomplete.join(format!("frame_{n:04}.png"))).unwrap(); } }
+    for force in [false, true] {
+        assert!(s.execute("media.relink", json!({"item": item.0, "path": incomplete.join("frame_0000.png").to_string_lossy(), "relinkOthers": false, "force": force})).is_err());
+    }
+    assert_eq!(red_at(&s, item, 6), 60);
+    let _ = std::fs::remove_dir_all(dir);
+}
