  "adaptations": [
    {
      "id": "interview-edit",
      "title": "保留上下文的采访摘编",
      "sourceIds": [
        "calesthio/generative-media-skills/talking-head-podcast-recut",
        "skillhub:affaan-m-ecc-video-editing"
      ],
      "adaptation": "先读完整问题和回答，记录原始片段及起止位置，再以实际片段ID修剪。保留否定、条件和说话人上下文；字幕回听，不用截断后的语句改变原意。",
      "taskCheck": "首尾音节完整，原素材位置可追溯，摘编不改变论点。",
      "capabilityBoundary": "转录和说话人识别不是这组命令提供的能力；tick、秒和帧按各方法分别换算。",
      "existingRecipe": "skills/filmcraft-interview-edit/references/craft-steps.json",
      "recipe": {
        "schema": "craft-scenario-playbooks/v1",
        "application": "filmcraft",
        "id": "interview-edit",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "按议题建立素材箱",
            "command": "file.newBin",
            "params": {
              "name": "Interview topics"
            }
          },
          {
            "purpose": "在可靠议题边界添加标记",
            "command": "markers.add",
            "params": {
              "target": "program",
              "time": 0,
              "name": "议题起点",
              "comment": "核对原始上下文"
            }
          },
          {
            "purpose": "只对明确片段ID修剪示例",
            "command": "timeline.trim",
            "params": {
              "clip": 1,
              "edge": "out",
              "mode": "regular",
              "deltaFrames": -5
            }
          },
          {
            "purpose": "检查修剪后序列",
            "command": "sequence.inspect",
            "params": {}
          }
        ],
        "check": "首尾词完整、语义忠实、没有截断发音，字幕与说话人一致。",
        "boundary": "clip=1是示例，必须从序列实际返回ID取得；不靠拼接改变原话含义。",
        "templateOnly": true,
        "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    }
  ],
