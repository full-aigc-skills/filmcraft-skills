    {
      "id": "color-match",
      "title": "参考镜头匹配与风格分离",
      "sourceIds": [
        "calesthio/generative-media-skills/color-grading-finishing"
      ],
      "adaptation": "先确认素材和序列的色彩设置，再选参考帧进行匹配；比较肤色、产品颜色和高光，匹配后再决定风格，而不是一开始叠加多个LUT。",
      "taskCheck": "相邻镜头的主体颜色和曝光衔接正常，参考帧明确。",
      "capabilityBoundary": "启用Rec.709设置不代表已完成未知Log输入转换或HDR交付认证。",
      "existingRecipe": "skills/filmcraft-color-match/references/craft-steps.json",
      "recipe": {
        "schema": "craft-scenario-playbooks/v1",
        "application": "filmcraft",
        "id": "color-match",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "检查序列工作空间",
            "command": "color.spaces",
            "params": {}
          },
          {
            "purpose": "按素材来源确认工作空间",
            "command": "sequence.colorSettings",
            "params": {
              "workingSpace": "rec709",
              "wideGamut": false,
              "autoToneMap": false
            }
          },
          {
            "purpose": "对明确选中片段匹配参考帧",
            "command": "lumetri.applyMatch",
            "params": {
              "referenceFrame": 0,
              "faceDetection": true,
              "clip": {
                "$ref": "clip"
              }
            }
          },
          {
            "purpose": "检查序列内容",
            "command": "sequence.inspect",
            "params": {}
          }
        ],
        "check": "相邻镜头反复切换比较肤色、中性物体、黑白点，不能只看一帧。",
        "boundary": "参考帧需换成实际镜头；HDR素材不得盲设rec709和关闭tone map。 参考帧必须处于另一个镜头，不能位于目标片段内部；先检查sequence.inspect的startFrame/endFrame及源素材，明确clip参数，避免重开工程后的选择丢失。",
        "templateOnly": true,
        "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。",
        "bindings": "执行前从当前sequence.inspect取得唯一目标片段ID，替换$ref:clip整个对象为实际整数。此记号不是原生参数，不使用预设clip=1。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    }
