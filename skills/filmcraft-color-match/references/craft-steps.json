{
  "schema": "craft-scenario-playbooks/v1",
  "application": "filmcraft",
  "id": "color-match",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "检查序列工作空间",
      "command": "color.spaces",
      "params": {}
    },
    {
      "purpose": "按素材来源确认工作空间",
      "command": "sequence.colorSettings",
      "params": {
        "workingSpace": "rec709",
        "wideGamut": false,
        "autoToneMap": false
      }
    },
    {
      "purpose": "对明确选中片段匹配参考帧",
      "command": "lumetri.applyMatch",
      "params": {
        "referenceFrame": 0,
        "faceDetection": true
      }
    },
    {
      "purpose": "检查序列内容",
      "command": "sequence.inspect",
      "params": {}
    }
  ],
  "check": "相邻镜头反复切换比较肤色、中性物体、黑白点，不能只看一帧。",
  "boundary": "参考帧需换成实际镜头；HDR素材不得盲设rec709和关闭tone map。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
