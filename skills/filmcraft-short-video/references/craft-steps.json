{
  "schema": "craft-scenario-playbooks/v1",
  "application": "filmcraft",
  "id": "short-video",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "先建立素材精选箱",
      "command": "file.newBin",
      "params": {
        "name": "Selects"
      }
    },
    {
      "purpose": "创建目标比例序列",
      "command": "file.newSequence",
      "params": {
        "name": "Short",
        "width": 1080,
        "height": 1920,
        "fps": 30
      }
    },
    {
      "purpose": "在已选素材与源入出点明确后插入",
      "command": "source.insert",
      "params": {}
    },
    {
      "purpose": "按需在当前实际剪辑轨做分割",
      "command": "timeline.razor",
      "params": {
        "time": 762048000000,
        "track": "V1"
      }
    },
    {
      "purpose": "核对序列结构",
      "command": "sequence.inspect",
      "params": {}
    }
  ],
  "check": "3秒示例位置对应254016000000ticks/秒，重看开头、主体、结尾与音画连续。",
  "boundary": "插入前必须指定源素材和范围；示例ticks不适合任意帧率边界，要按实际帧对齐。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
