{
  "schema": "craft-scenario-playbooks/v1",
  "application": "filmcraft",
  "id": "product-video",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立商品镜头分组",
      "command": "file.newBin",
      "params": {
        "name": "Product details"
      }
    },
    {
      "purpose": "导入实际已授权素材",
      "command": "file.import",
      "params": {
        "paths": [
          "input/product.mp4"
        ]
      }
    },
    {
      "purpose": "新建匹配平台序列",
      "command": "file.newSequence",
      "params": {
        "name": "Product",
        "width": 1920,
        "height": 1080,
        "fps": 25
      }
    },
    {
      "purpose": "选定素材后按源范围插入",
      "command": "source.insert",
      "params": {}
    },
    {
      "purpose": "检查序列结构",
      "command": "sequence.inspect",
      "params": {}
    }
  ],
  "check": "型号、真实卖点、规格文字、镜头对应，结尾行动入口完整。",
  "boundary": "导入返回item后需选定源与入出点；导入+新序列不会自动完成剪辑。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
